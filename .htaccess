<FilesMatch "^\.env($|\.)">
    Require all denied
</FilesMatch>

# --- Archivos internos que no deben servirse por HTTP ---
# Metadatos de Git y dependencias
RedirectMatch 404 (^|/)\.git(/|$)
RedirectMatch 404 (^|/)(vendor|database)(/|$)

<FilesMatch "(?i)(\.sql|\.md|\.lock|\.phar|\.log|\.bak|\.dist)$|^composer\.json$">
    Require all denied
</FilesMatch>

# --- Cabeceras de seguridad (solo si mod_headers está activo) ---
<IfModule mod_headers.c>
    # Evita que el token de reset/verificación viaje en el Referer a CDNs de terceros
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Nunca listar directorios
Options -Indexes
